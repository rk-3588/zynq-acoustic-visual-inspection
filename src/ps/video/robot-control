#!/bin/sh
### BEGIN INIT INFO
# Provides:          robot-control
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: UART1 gripper service, never transmits on start
### END INIT INFO
DAEMON=/usr/bin/robot_control_daemon
PIDFILE=/run/robot-control.pid
running() {
    prior=$(cat "$PIDFILE" 2>/dev/null || true)
    case "$prior" in ''|*[!0-9]*) return 1;; esac
    [ "$(readlink /proc/"$prior"/exe 2>/dev/null)" = "$DAEMON" ] && kill -0 "$prior" 2>/dev/null
}
case "$1" in
 restart) "$0" stop && "$0" start; exit $? ;;
 start|stop|status) ;;
 *) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
exec 9>/run/robot-control-service.lock
flock -n 9 || exit 1
case "$1" in
 start)
    if running; then echo "robot-control already running"; exit 0; fi
    [ -x "$DAEMON" ] || exit 1
    nohup "$DAEMON" >/run/robot-control.log 2>&1 </dev/null 9>&- &
    child=$!; printf '%s\n' "$child" >"$PIDFILE.new"; mv "$PIDFILE.new" "$PIDFILE"
    i=0
    while [ "$i" -lt 20 ]; do
        if ! kill -0 "$child" 2>/dev/null; then rm -f "$PIDFILE"; exit 1; fi
        if [ -S /run/robot-control.sock ]; then echo "robot-control started (no startup packet)"; exit 0; fi
        sleep .1; i=$((i+1))
    done
    kill -TERM "$child"; exit 1 ;;
 stop)
    if running; then
        kill -TERM "$prior" || exit 1
        i=0
        while kill -0 "$prior" 2>/dev/null && [ "$i" -lt 30 ]; do sleep .1; i=$((i+1)); done
        if kill -0 "$prior" 2>/dev/null; then echo "robot-control stop timed out; no forced kill"; exit 1; fi
    fi
    rm -f "$PIDFILE"; echo "robot-control stopped; this is NOT a mechanical stop command" ;;
 status) if running; then echo "robot-control running pid=$prior"; exit 0; fi; echo "robot-control stopped"; exit 3 ;;
esac
